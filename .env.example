# ============================================================================
# .env.example — Template d'environnement Agent BI v5.0
# ----------------------------------------------------------------------------
# Copier vers .env puis remplir les valeurs. Ne JAMAIS commiter .env.
# Pour un déploiement Docker prêt à l'emploi, voir .env.deploy + DEPLOY_DOCKER.md
# ============================================================================


# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# En dev : http://127.0.0.1:8000
# Docker : laisser vide (Nginx proxifie /api → backend)
VITE_API_URL=http://127.0.0.1:8000


# ── Sécurité JWT (OBLIGATOIRE en production) ─────────────────────────────────
# Génération : python -c "import secrets; print(secrets.token_urlsafe(48))"
# Le backend refuse de démarrer en prod si < 32 caractères.
JWT_SECRET=change_this_to_a_random_64_char_secret_string
JWT_ISSUER=agent-bi
JWT_EXPIRE_SECONDS=86400
APP_ENV=development
ENVIRONMENT=development
COOKIE_SECURE=0
COOKIE_SAMESITE=lax


# ── CORS ─────────────────────────────────────────────────────────────────────
# Origines autorisées, séparées par virgules.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
FRONTEND_URL=http://localhost:5173


# ── Base de données SQL Server 2022 ──────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YOUR_SA_PASSWORD_HERE
DB_NAME=agent_dw_meta


# ── LLM : Blaze GLM-5 (priorité 1) + Ollama local (priorité 2) ──────────────
# Blaze GLM-5 via API OpenAI-compatible (cloud, haute performance)
BLAZE_API_KEY=sk-blaze-wuAdOktbeX65NxuxmnLrimuMxrQGeTymxsSMpyxLEi1RWkOH
BLAZE_BASE_URL=https://api.blaze.ai/v1
BLAZE_MODEL=glm-5
BLAZE_MAX_TOKENS=16384
BLAZE_TIMEOUT=300
# Si Blaze échoue, fallback sur Ollama local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ANALYSIS_MODEL=mistral:latest
OLLAMA_CODE_MODEL=qwen2.5-coder:7b


# ── SMTP (envoi d'emails) ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=YOUR_EMAIL@gmail.com
SMTP_PASS=YOUR_SMTP_APP_PASSWORD_HERE


# ── Composio (intégrations tierces, optionnel) ───────────────────────────────
COMPOSIO_API_KEY=YOUR_COMPOSIO_API_KEY_HERE


# ── Chemins internes (ne modifier qu'en cas de besoin Docker spécifique) ─────
SQLSERVER_BACKUP_MOUNT_DIR=/var/opt/mssql/backup
SQLSERVER_DATA_DIR=/var/opt/mssql/data
BAK_UPLOAD_DIR=./uploads/bak