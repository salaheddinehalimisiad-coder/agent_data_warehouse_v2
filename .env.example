# ============================================================
# Agent Data Warehouse - Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs.
# .env est dans .gitignore, NE JAMAIS le committer.
# ============================================================

# --- SQL Server ---
DB_PASSWORD=ReplaceMeWithStrongPassword!23
SQLSERVER_HOST_PORT=14330           # port expose en local (dev seulement)
MSSQL_PID=Developer                  # Developer | Express | Standard | Enterprise

# --- LLM Priorité 1 : DeepSeek (recommandé, OpenAI-compatible) ---
# Créer une clé sur https://platform.deepseek.com/api_keys
# Modèles : deepseek-chat (V3, rapide) | deepseek-reasoner (R1, raisonnement)
# Rotation : plusieurs cles separees par virgule (backup automatique)
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_API_KEYS=sk-your-deepseek-key-1,sk-your-deepseek-key-2
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=8192
DEEPSEEK_TIMEOUT=120

# --- LLM Priorité 2 : Blaze GLM-5 (fallback si DeepSeek indisponible) ---
BLAZE_API_KEY=replace-me-with-real-key
BLAZE_BASE_URL=https://api.blaze.ai/v1
BLAZE_MODEL=glm-5

# --- LLM Human Review (chat_modifier) — PRIORITAIRE ---
# Plusieurs cles separees par virgule -> rotation round-robin
# Pour ZhipuAI BigModel : https://open.bigmodel.cn -> API Keys
GLM5_API_KEYS=your_glm5_api_key_1,your_glm5_api_key_2
GLM5_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM5_MODEL=glm-4-plus           # glm-4-plus | glm-4 | glm-4-flash | glm-4-air

# OpenRouter (fallback si GLM-5 KO)
# Cle a creer sur https://openrouter.ai/keys
# Rotation : plusieurs cles separees par virgule (backup automatique)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_API_KEYS=sk-or-v1-your-openrouter-key-1,sk-or-v1-your-openrouter-key-2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=z-ai/glm-4.5    # ou meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_REFERER=https://github.com/salaheddinehalimisiad-coder/agent_data_warehouse_v2

# --- LLM local (Ollama) optionnel ---
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Backend ---
JWT_SECRET=replace-me-with-64-chars-random-string-do-not-reuse-anywhere-else
BACKEND_WORKERS=2
BACKEND_TIMEOUT=180
BACKEND_HOST_PORT=8000
LOG_LEVEL=info
APP_ENV=development              # development | production
# CORS - liste separee par virgules, en prod ne mettre que les domaines reels
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Pool DB SQLAlchemy ---
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- Cache LLM ---
LLM_CACHE_ENABLED=1
LLM_CACHE_TTL=3600
LLM_CACHE_SIZE=256

# --- Observabilite ---
METRICS_ENABLED=1
LOG_FORMAT=text                    # text | json (json -> ingestion ELK/Loki)

# --- Reverse-proxy SSL (prod uniquement) ---
DOMAIN=localhost                   # ex: app.exemple.com pour Let's Encrypt
ACME_EMAIL=admin@example.com

# --- Frontend ---
FRONTEND_HOST_PORT=8080

# --- Registry / tag (prod) ---
REGISTRY=local
TAG=latest
