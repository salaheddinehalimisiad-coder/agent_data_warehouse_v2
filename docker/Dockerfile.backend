# syntax=docker/dockerfile:1.7
# ============================================================
# Agent Data Warehouse — Backend (FastAPI + LangGraph)
# Production-ready : multi-stage, slim, non-root, gunicorn
# ============================================================

# ---------------- Stage 1 : builder ----------------
FROM python:3.11.9-slim-bookworm AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=120

WORKDIR /build

# Build dependencies (only in builder stage - dropped from final image)
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
        g++ \
        unixodbc-dev \
        curl \
        ca-certificates \
        gnupg2 \
        apt-transport-https \
    && rm -rf /var/lib/apt/lists/*

# Create venv and install dependencies (cached layer)
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt && \
    pip install gunicorn>=22.0.0

# ---------------- Stage 2 : runtime ----------------
FROM python:3.11.9-slim-bookworm AS runtime

# OCI image labels (traceability)
LABEL org.opencontainers.image.title="Agent DW Backend" \
      org.opencontainers.image.description="FastAPI + LangGraph multi-agent data warehouse pipeline" \
      org.opencontainers.image.vendor="Agent DW" \
      org.opencontainers.image.source="https://github.com/agent-dw/backend" \
      org.opencontainers.image.licenses="Proprietary"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH="/opt/venv/bin:$PATH" \
    PORT=8000 \
    APP_ENV=production

WORKDIR /app

# Runtime system dependencies (minimal: ODBC + curl for healthcheck + tini for PID 1)
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        gnupg2 \
        apt-transport-https \
        unixodbc \
        tini \
    && curl -sSL https://packages.microsoft.com/keys/microsoft.asc \
       | gpg --dearmor > /usr/share/keyrings/microsoft-prod.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/microsoft-prod.gpg] \
       https://packages.microsoft.com/debian/12/prod bookworm main" \
       > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y --no-install-recommends \
       msodbcsql18 \
    && apt-get purge -y --auto-remove gnupg2 apt-transport-https \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Copy venv from builder
COPY --from=builder /opt/venv /opt/venv

# Create non-root user (uid 1000) and runtime directories
RUN groupadd --system --gid 1000 appuser \
    && useradd --system --uid 1000 --gid appuser --shell /bin/bash --create-home appuser \
    && mkdir -p /app/uploads/bak /app/outputs /app/logs \
    && chown -R appuser:appuser /app

# Copy source as non-root, in dependency-stable order to maximize cache hits
COPY --chown=appuser:appuser app_state.py main.py ./
COPY --chown=appuser:appuser api ./api
COPY --chown=appuser:appuser nodes ./nodes
COPY --chown=appuser:appuser utils ./utils

USER appuser

EXPOSE 8000

# Healthcheck on /health endpoint
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:${PORT}/health || exit 1

# tini as PID 1 → proper signal handling for graceful shutdown
ENTRYPOINT ["/usr/bin/tini", "--"]

# Gunicorn with uvicorn workers : production-grade ASGI server with auto-scaling
# WORKERS env can override (default: 2). --preload for shared memory across workers
CMD ["sh", "-c", "exec gunicorn api.server:app \
    --bind 0.0.0.0:${PORT} \
    --workers ${WORKERS:-2} \
    --worker-class uvicorn.workers.UvicornWorker \
    --timeout ${TIMEOUT:-120} \
    --graceful-timeout 30 \
    --keep-alive 5 \
    --access-logfile - \
    --error-logfile - \
    --log-level ${LOG_LEVEL:-info}"]
