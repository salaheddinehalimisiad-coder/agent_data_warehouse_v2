# syntax=docker/dockerfile:1.7
# ============================================================
# Agent Data Warehouse — Frontend (React + Vite)
# Production : Vite build -> nginx unprivileged
# ============================================================

# ---------------- Stage 1 : build ----------------
FROM node:20.13-alpine AS builder

WORKDIR /build

# Cache deps layer separately
COPY package.json package-lock.json* ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --no-audit --no-fund --prefer-offline

# Copy source. .dockerignore already excludes node_modules/.venv/etc.
COPY index.html vite.config.js postcss.config.js tailwind.config.js ./
COPY public ./public
COPY src ./src

# API URL injected at build time (empty = same-origin via nginx proxy)
ARG VITE_API_URL=""
ENV VITE_API_URL=$VITE_API_URL \
    NODE_ENV=production

RUN npm run build

# ---------------- Stage 2 : runtime (unprivileged nginx) ----------------
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

LABEL org.opencontainers.image.title="Agent DW Frontend" \
      org.opencontainers.image.description="React + Vite SPA served by nginx" \
      org.opencontainers.image.vendor="Agent DW" \
      org.opencontainers.image.licenses="Proprietary"

# Switch back to root briefly for config + permissions, then drop to nginx user
USER root

# Custom nginx config (proxy /api to backend, gzip, security headers)
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Copy build artifacts
COPY --from=builder --chown=nginx:nginx /build/dist /usr/share/nginx/html

# Ensure cache + run dirs are writable by nginx user (uid 101 in unprivileged image)
RUN mkdir -p /var/cache/nginx /var/run \
    && chown -R nginx:nginx /var/cache/nginx /var/run /usr/share/nginx/html

USER nginx

EXPOSE 8080

# Healthcheck (uses wget which is built into nginx-unprivileged alpine)
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:8080/ > /dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
